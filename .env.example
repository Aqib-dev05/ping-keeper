# MongoDB Atlas free tier (M0). Network Access mein 0.0.0.0/0 allow karna (Vercel ke liye)
MONGODB_URI="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/pingkeeper?retryWrites=true&w=majority"

# openssl rand -base64 32
JWT_SECRET="change-me"

# Cron endpoint ko protect karta hai. Scheduler isi secret se call karega
CRON_SECRET="change-me-too"

# Optional: per-user monitor limit (default 50)
# MAX_MONITORS=50
